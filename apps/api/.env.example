# ── Core ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/callcenter_crm?schema=public

# ── Redis / Queues ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (change in production) ────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
JWT_ISSUER=callcenter-crm

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ── Telephony ──────────────────────────────────────────────────────
TELEPHONY_PROVIDER=EXOTEL

# Exotel
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Knowlarity
KNOWLARITY_ACCOUNT_ID=
KNOWLARITY_API_KEY=

# TATA Smartflo (cloudphone.tatateleservices.com)
TATA_API_URL=https://api-smartflo.tatateleservices.com
TATA_EMAIL=
TATA_PASSWORD=
TATA_AGENT_NUMBER=
TATA_CALLER_ID=

# ── Storage (S3 compatible) ────────────────────────────────────────
STORAGE_BUCKET=callcenter-crm
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# ── Notifications ──────────────────────────────────────────────────
FCM_SERVER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=